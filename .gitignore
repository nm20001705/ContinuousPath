### AL ###
#Template for AL projects for Dynamics 365 Business Central
#launch.json folder
.vscode/
#Cache folder
.alcache/
#Symbols folder
.alpackages/
#Snapshots folder
.snapshots/
#Testing Output folder
.output/
#Extension App-file
*.app
#Rapid Application Development File
rad.json
#Translation Base-file
*.g.xlf
#License-files
*.bclicense
*.flf
#Test results file
TestResults.xml
.in/
.out/
notes.md
*.stl

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.pytest_cache/
*.egg-info/

# --- FreeCAD ---
*.FCBak
*.FCStd1
*.FCStd.*

# --- generated output ---
*.stl
*.3mf
*.gcode
*.pkl

# local machine-specific config (paths etc.)
config.local.toml

# generated example outputs (the .FCStd input IS tracked; these are not)
examples/*.stl
examples/*.pkl
examples/*.FCBak

# local editor settings (machine-specific FreeCAD path)
settings.json
